{
  "name": "survey",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint:css": "stylelint \"src/**/*.css\" --allow-empty-input",
    "preview": "vite preview",
    "extract:tw": "node scripts/extract-classes.js --tailwind",
    "count:loc": "node scripts/count-loc.js",
    "generate-tailwind-dump": "node scripts/generate-tailwind-dump.js",
    "generate-tailwind-dump:win": "node scripts/generate-tailwind-dump-win2.js",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,css,scss,md,json,html}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,css,scss,md,json,html}\"",
    "prepare": "husky",
    "fmt:deno": "deno fmt netlify/edge-functions",
    "format:full": "npm run format && npm run fmt:deno",
    "lint-staged": "lint-staged",
    "scrape:cortideri": "node scripts/scrape-cortideri.js",
    "rag:chat": "node scripts/rag_chat_cli.js",
    "check:deno": "deno check netlify/edge-functions/**/*.js",
    "check:node": "node scripts/check_node_syntax.js",
    "check": "npm run check:deno && npm run check:node",
    "set-ngrok": "node scripts/set-ngrok.js"
  },
  "lint-staged": {
    "*.{js,jsx,css,md}": "prettier --write"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "@google/generative-ai": "^0.24.1",
    "@huggingface/inference": "^4.13.3",
    "@mistralai/mistralai": "^1.10.0",
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/supabase-js": "^2.76.1",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.17",
    "cheerio": "^1.1.2",
    "dompurify": "^3.3.0",
    "dotenv": "^17.2.3",
    "leaflet": "^1.9.4",
    "marked": "^16.4.1",
    "openai": "^4.104.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-leaflet": "^4.2.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.9.4",
    "recharts": "^2.5.0",
    "remark-gfm": "^4.0.1",
    "supabase": "^2.63.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.4.22",
    "chromatic": "^13.3.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "minimist": "^1.2.8",
    "ngrok": "^5.0.0-beta.2",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "stylelint": "^16.26.0",
    "stylelint-config-standard": "^39.0.1",
    "tailwindcss": "^4.1.17",
    "vite": "^5.4.21"
  }
}
