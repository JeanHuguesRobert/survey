# .env.example
# Frontend
VITE_SUPABASE_URL=https://xxx.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# Frontend — Configuration générique (commune, mouvement, parti)
VITE_CITY_NAME=Corte
VITE_CITY_TAGLINE=CAPITALE
VITE_MOVEMENT_NAME=Pertitellu
VITE_PARTY_NAME=Petit Parti
VITE_HASHTAG=#PERTITELLU
VITE_BOT_NAME=Ophélien
VITE_VOLUNTEER_URL=https://entraide-cortenaise.lovable.app/
VITE_CONTACT_EMAIL=jeanhuguesrobert@gmail.com

# Frontend — Configuration Carte
VITE_MAP_DEFAULT_CENTER=42.3094,9.1490

# Frontend — Configuration type de communauté
VITE_COMMUNITY_NAME=Corte
VITE_COMMUNITY_TYPE=municipality
# Types supportés: municipality, association, school, company, cooperative, online_community, neighborhood, professional, cultural, health

# Backend (Functions)
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
GITHUB_TOKEN=ghp_your_token

# Paramètres génériques consommés côté fonctions
CITY_NAME=Corte
MOVEMENT_NAME=Pertitellu
PARTY_NAME=Petit Parti
HASHTAG=#PERTITELLU
BOT_NAME=Ophélien

# Paramètres type de communauté consommés côté fonctions
COMMUNITY_NAME=Corte
COMMUNITY_TYPE=municipality

# Backend (Functions) — Providers
# Clé Hugging Face (optionnelle si vous utilisez OpenAI)
HUGGINGFACE_API_KEY=hf_xxx

# OAuth Providers (Netlify Functions)
# Set these to enable provider-based avatar import# Facebook OAuth (Netlify Functions) & Facebook App ID (frontend)
VITE_FACEBOOK_APP_ID=your_facebook_app_id
VITE_FACEBOOK_PAGE_URL=https://www.facebook.com/your-page-url
# Server: preferred - set an app access token (app or long-lived token) for server-side calls
# Example: obtained via Graph API client_credentials grant
FACEBOOK_TOKEN=your_facebook_app_access_token
# Optional fallback: app secret (required only for some server flows such as the Data Deletion
# callback or if you do server-side token exchange). Keep this secret out of the repo.
FACEBOOK_CLIENT_SECRET=your_facebook_client_secret

# Optional: base URL of your deployed site (used to build OAuth redirect URIs for backend flows)
APP_BASE_URL=https://your-site.netlify.app

# OpenAI (utilisé en priorité si défini)
OPENAI_API_KEY=sk-xxx
OPENAI_MODEL=
OPENAI_MODERATION_MODEL=

# Mistral
MISTRAL_API_KEY=your_mistral_key

# Anthropic
ANTHROPIC_API_KEY=sk-your_anthropic_key
ANTHROPIC_MODEL=

# EdenAI
EDENAI_KEY=your_edenai_key

# Web Search
BRAVE_SEARCH_API_KEY=your_brave_key
