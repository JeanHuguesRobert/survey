# App
APP_VERSION="1.0.8"
DEPLOY_DATE="2025-10-28"

# Frontend
VITE_SUPABASE_URL=https://xxx.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# Frontend — Configuration générique (commune, mouvement, parti)
VITE_CITY_NAME=Corte
VITE_CITY_TAGLINE=CAPITALE
VITE_MOVEMENT_NAME=Pertitellu
VITE_PARTY_NAME=Petit Parti
VITE_HASHTAG=#PERTITELLU
VITE_BOT_NAME=Ophélien
VITE_VOLUNTEER_URL=https://entraide-cortenaise.lovable.app/

# Frontend — Configuration type de communauté
VITE_COMMUNITY_NAME=Corte
VITE_COMMUNITY_TYPE=municipality
# Types supportés: municipality, association, school, company, cooperative, online_community, neighborhood, professional, cultural, health

# Backend (Functions)
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
GITHUB_TOKEN=ghp_your_token

# Backend (Functions) — Prompt et configuration générique
# Option 1 : pointer vers un fichier (par défaut public/prompts/bob-system.md)
# HF_SYSTEM_PROMPT_PATH=public/prompts/bob-system.md
# Option 2 : définir le prompt directement
# HF_SYSTEM_PROMPT="Tu es l’assistant citoyen ..."

# Paramètres génériques consommés côté fonctions
CITY_NAME=Corte
MOVEMENT_NAME=Pertitellu
PARTY_NAME=Petit Parti
HASHTAG=#PERTITELLU
BOT_NAME=Ophélia

# Paramètres type de communauté consommés côté fonctions
COMMUNITY_NAME=Corte
COMMUNITY_TYPE=municipality
```

